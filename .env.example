# GEMINI_API_KEY: Required for server-side Google Gemini AI complaint analysis.
# Configure this via the Secrets panel in AI Studio or in your local .env file.
GEMINI_API_KEY=""

# APP_URL: Public URL where the CivicLens web application is hosted.
# Used for deployment metadata and reference links.
APP_URL=""

# NODE_ENV: Set to "production" when running the compiled production build.
NODE_ENV="development"
